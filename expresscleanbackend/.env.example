# --- Runtime ---
NODE_ENV=development
PORT=3000
API_PREFIX=/api
API_VERSION=v1

# --- MongoDB ---
MONGO_URL=mongodb://localhost:27017/express_clean

# --- JWT (jose) ---
# Use a strong random string >= 32 chars. JOSE will derive an HMAC key from it.
JWT_SECRET=please-change-me-please-change-me-32+
JWT_ISSUER=express-clean-scaffold
JWT_AUDIENCE=express-clean-clients
JWT_EXPIRES_IN=15m

# --- crypto-js (symmetric encryption for tokens, PII at rest, etc.) ---
CRYPTO_SECRET=please-change-me-please-change-me-32+

# --- Loki (winston-loki transport) ---
LOKI_HOST=http://localhost:3100
LOKI_BATCHING=true
LOKI_INTERVAL=5
LOKI_LABELS_APP=express-clean-scaffold

# --- Rate limit ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
